  wasteSpawnPosition: {x: -180, y: -10}
  activeFishSprite: {fileID: 0}
  lostFishSprite: {fileID: 0}
  wasteCatalog:
  - itemId: "botella_pet"
    displayName: "Botella Plástica PET"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000001, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Las botellas plásticas limpias y vacías son aprovechables: van en la caneca AZUL [1]." 
  - itemId: "cascara_banano"
    displayName: "Cáscara de Banano"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000002, type: 3}
    correctCategory: 2
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Las cáscaras de fruta son residuos orgánicos biodegradables: van en la caneca VERDE [3]." 
  - itemId: "paquete_engrase"
    displayName: "Empaque Engrasado (Trampa)"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000003, type: 3}
    correctCategory: 3
    isTrapItem: 1
    pedagogicalHint: "¡Cuidado! Este empaque tiene manchas de grasa y comida, por eso NO es reciclable: va en la GRIS [4]." 
  - itemId: "computador_raee"
    displayName: "Computador Dañado (RAEE)"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000004, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Los aparatos electrónicos dañados (RAEE) requieren manejo especial en la caneca ROJA [2]." 
  - itemId: "caja_carton"
    displayName: "Caja de Cartón Limpia"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000005, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "¡Pista! El cartón limpio, seco y sin restos de grasa es 100% reciclable: va en la caneca AZUL [1]." 
  - itemId: "restos_manzana"
    displayName: "Restos de Manzana"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000006, type: 3}
    correctCategory: 2
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Los corazones y restos de manzana sirven para compostaje en la caneca VERDE [3]." 
  - itemId: "servilleta_usada"
    displayName: "Servilleta Usada (Trampa)"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000007, type: 3}
    correctCategory: 3
    isTrapItem: 1
    pedagogicalHint: "¡Ojo! Aunque viene del papel, la servilleta sucia o engrasada pierde su reciclabilidad: va en la GRIS [4]." 
  - itemId: "llanta_usada"
    displayName: "Llanta Usada Posconsumo"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000008, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Las llantas son residuos especiales posconsumo y no van en la basura común: caneca ROJA [2]." 
  - itemId: "lata_aluminio"
    displayName: "Lata de Aluminio"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000009, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Las latas de aluminio limpias se funden y aprovechan de nuevo: van en la caneca AZUL [1]." 
  - itemId: "cascara_naranja"
    displayName: "Cáscara de Naranja"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000010, type: 3}
    correctCategory: 2
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Los restos cítricos y cáscaras naturales son orgánicos: van en la caneca VERDE [3]." 
  - itemId: "papel_limpio"
    displayName: "Papel Limpio Arrugado"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000011, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "¡Pista! El papel blanco limpio (así esté arrugado) sí es aprovechable: va en la caneca AZUL [1]." 
  - itemId: "colchon_viejo"
    displayName: "Colchón Viejo Desechado"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000012, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "¡Pista! Los colchones y residuos voluminosos requieren recolección especial: van en la caneca ROJA [2]." 
