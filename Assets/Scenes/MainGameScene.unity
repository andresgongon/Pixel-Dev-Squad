  wasteCatalog:
  - itemId: botella_pet
    displayName: "Botella Pl\xE1stica PET Limpia"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000001, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "\xA1Aprovechable! Envase pl\xE1stico limpio, seco y escurrido.
      Se recicla en la caneca BLANCA [1]."
  - itemId: caja_carton
    displayName: "Caja de Cart\xF3n Seca y Limpia"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000005, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "\xA1Aprovechable! Cart\xF3n seco sin grasa ni humedad. Su fibra
      se recupera en la caneca BLANCA [1]."
  - itemId: lata_aluminio
    displayName: Lata de Aluminio Limpia
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000009, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "\xA1Aprovechable! Los metales limpios se funden y reutilizan
      indefinidamente en la caneca BLANCA [1]."
  - itemId: papel_limpio
    displayName: Papel de Archivo Seco
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000011, type: 3}
    correctCategory: 0
    isTrapItem: 0
    pedagogicalHint: "\xA1Aprovechable! Hojas de papel secas y limpias sin restos
      biol\xF3gicos. Van en la caneca BLANCA [1]."
  - itemId: tetrapak_limpio
    displayName: Envase Tetra Pak Escurrido
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000013, type: 3}
    correctCategory: 0
    isTrapItem: 1
    pedagogicalHint: "\xA1Buen dato! Aunque combina cart\xF3n, pl\xE1stico y aluminio,
      en Colombia se recupera limpio y seco en la caneca BLANCA [1]."
  - itemId: cascara_banano
    displayName: "C\xE1scara de Banano y Frutas"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000002, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "\xA1Org\xE1nico! Materia vegetal biodegradable ideal para compostaje
      y abono natural en la caneca VERDE [2]."
  - itemId: restos_manzana
    displayName: "Coraz\xF3n y Restos de Manzana"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000006, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "\xA1Org\xE1nico! Desechos de comida cruda que se descomponen
      y enriquecen la tierra en la caneca VERDE [2]."
  - itemId: cascara_naranja
    displayName: "C\xE1scaras de C\xEDtricos y Verduras"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000010, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "\xA1Org\xE1nico! Biomasa vegetal natural que aporta nutrientes
      al suelo sin contaminar en la caneca VERDE [2]."
  - itemId: hojas_poda
    displayName: "Hojas Secas y Poda de Jard\xEDn"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000015, type: 3}
    correctCategory: 1
    isTrapItem: 0
    pedagogicalHint: "\xA1Org\xE1nico! Los restos vegetales de poda y jardiner\xEDa
      son base clave para compostaje en la caneca VERDE [2]."
  - itemId: bolsita_te
    displayName: "Bolsita de T\xE9 Usada"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000014, type: 3}
    correctCategory: 1
    isTrapItem: 1
    pedagogicalHint: "\xA1Buen dato! Las hojas de t\xE9 y su filtro natural (sin
      grapa met\xE1lica) son compostables en la caneca VERDE [2]."
  - itemId: servilleta_usada
    displayName: Servilleta Usada con Grasa
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000007, type: 3}
    correctCategory: 2
    isTrapItem: 1
    pedagogicalHint: "\xA1Cuidado! Aunque viene del papel, la grasa y fluidos impiden
      reciclarla. Va en la caneca NEGRA [3]."
  - itemId: paquete_engrase
    displayName: Paquete Metalizado de Snacks
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000003, type: 3}
    correctCategory: 2
    isTrapItem: 1
    pedagogicalHint: "\xA1Ojo! Parece aluminio, pero es pl\xE1stico metalizado (BOPP)
      con aceite y sal. Va en la caneca NEGRA [3]."
  - itemId: caja_pizza_grasosa
    displayName: Caja de Pizza con Grasa
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000016, type: 3}
    correctCategory: 2
    isTrapItem: 1
    pedagogicalHint: "\xA1Cuidado! El cart\xF3n manchado con queso y aceite contamina
      el papel limpio. Va en la caneca NEGRA [3]."
  - itemId: vaso_cafe_encerado
    displayName: "Vaso Encerado de Caf\xE9"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000017, type: 3}
    correctCategory: 2
    isTrapItem: 1
    pedagogicalHint: "\xA1Ojo! Parece cart\xF3n, pero tiene una pel\xEDcula pl\xE1stica
      impermeable y manchas de bebida. Va en la caneca NEGRA [3]."
  - itemId: recibo_termico
    displayName: "Factura / Recibo T\xE9rmico"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000018, type: 3}
    correctCategory: 2
    isTrapItem: 1
    pedagogicalHint: "\xA1Cuidado! El papel t\xE9rmico de cajeros contiene recubrimiento
      qu\xEDmico (BPA) no reciclable. Va en la caneca NEGRA [3]."
  - itemId: pilas_gastadas
    displayName: Pilas Alcalinas Agotadas
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000019, type: 3}
    correctCategory: 3
    isTrapItem: 0
    pedagogicalHint: "\xA1Peligroso posconsumo! Contienen metales pesados t\xF3xicos
      (mercurio, litio, cadmio). Van en la caneca ROJA [4] (Pilas con el Ambiente)."
  - itemId: bombillo_ahorrador
    displayName: Bombillo Ahorrador Fundido
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000020, type: 3}
    correctCategory: 3
    isTrapItem: 1
    pedagogicalHint: "\xA1Peligro! Aunque tiene vidrio, contiene vapor de mercurio
      t\xF3xico. Requiere entrega en la caneca ROJA [4] (L\xFAmina)."
  - itemId: medicamentos_vencidos
    displayName: "Medicamentos Vencidos / Bl\xEDster"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000021, type: 3}
    correctCategory: 3
    isTrapItem: 0
    pedagogicalHint: "\xA1Peligroso posconsumo! Los f\xE1rmacos contaminan el agua
      y afectan la fauna del r\xEDo. Van en la caneca ROJA [4] (Punto Azul)."
  - itemId: celular_raee
    displayName: "Celular Da\xF1ado"
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000022, type: 3}
    correctCategory: 3
    isTrapItem: 0
    pedagogicalHint: "\xA1Residuo electr\xF3nico RAEE! Contiene bater\xEDa y metales
      t\xF3xicos; requiere recolecci\xF3n especial en la caneca ROJA [4]."
  - itemId: aerosol_quimico
    displayName: Aerosol / Insecticida Gastado
    itemSprite: {fileID: 21300000, guid: b1000000000000008000000000000023, type: 3}
    correctCategory: 3
    isTrapItem: 1
    pedagogicalHint: "\xA1Peligro! Aunque su envase es met\xE1lico, guarda restos
      qu\xEDmicos e inflamables a presi\xF3n. Va en la caneca ROJA [4]."
